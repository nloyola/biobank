[mysqld]
# Disable binary logging — not needed for local dev, reduces disk I/O
skip_log_bin

# Flush log buffer once per second instead of on every commit.
# Risk: up to 1 second of transactions lost on crash — acceptable for dev.
innodb_flush_log_at_trx_commit = 2

# Avoid double-buffering between InnoDB and the OS page cache.
innodb_flush_method = O_DIRECT

# Buffer pool: increase if your machine has RAM to spare.
# Rule of thumb: ~70% of available RAM, but 256M is a safe default.
innodb_buffer_pool_size = 256M

# Larger temp tables in memory before spilling to disk.
tmp_table_size = 64M
max_heap_table_size = 64M

