#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
ENV_FILE="$PROJECT_ROOT/.env"
COMPOSE_FILE="$PROJECT_ROOT/docker/compose.yaml"
OUTPUT_DIR="${1:-.}"

if [ ! -f "$ENV_FILE" ]; then
    echo "Error: .env file not found at $ENV_FILE" >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$ENV_FILE"

DBNAME="${DB_NAME:-biobank}"
FILENAME="$OUTPUT_DIR/${DBNAME}_$(date +%Y%m%d).sql.gz"

# tables to skip
skip_tables=( log_message object_attribute objectattributes )

OPTS=()
for table in "${skip_tables[@]}"; do
    OPTS+=("--ignore-table=${DBNAME}.${table}")
done

docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" --project-directory "$PROJECT_ROOT/docker" \
    exec -T db mariadb-dump "${OPTS[@]}" -u"$DB_ROOT_USER" -p"$DB_ROOT_PASSWORD" "$DBNAME" \
    | gzip > "$FILENAME"

echo "Database dumped to $FILENAME"
